<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ShiroBotSdkVersion Condition="'$(ShiroBotSdkVersion)' == ''">1.0.3</ShiroBotSdkVersion>
    <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
    <ShiroBotDevelopmentHostEnabled>false</ShiroBotDevelopmentHostEnabled>
    <PluginAssembly Condition="'$(PluginAssembly)' == ''">$(MSBuildThisFileDirectory)../../bin/Release/net10.0/publish/ShiroBot.AiChatPlugin.dll</PluginAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ShiroBot.SDK" Version="$(ShiroBotSdkVersion)" />
    <PluginContract Include="$(PluginAssembly)" />
  </ItemGroup>
</Project>
