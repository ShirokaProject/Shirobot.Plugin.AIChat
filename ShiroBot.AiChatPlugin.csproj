<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <Version>1.4.2</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <HostPluginDir>$(MSBuildProjectDirectory)/.debug-runtime/plugins/AiChatPlugin/</HostPluginDir>
        <Configurations>Debug;DebugPlugin;DebugAdapter;DebugAll;Release</Configurations>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' != 'Release'">false</ShiroBotPluginPackagingEnabled>
        <DebugType>portable</DebugType>
        <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram;ShiroBot.Meme.Contracts</ShiroBotPluginSharedAssemblies>
        <!-- 本地开发时 Meme 仓库与 AIChat 仓库同级；CI 可用 -p:MemeContractsProject=... 覆盖。 -->
        <MemeContractsProject Condition="'$(MemeContractsProject)' == ''">../Shirobot.Plugin.Meme/ShiroBot.Meme.Contracts/ShiroBot.Meme.Contracts.csproj</MemeContractsProject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Tests/**/*.cs;dev/**/*.cs;scripts/**/*.cs" />
        <InternalsVisibleTo Include="ShiroBot.AiChatPlugin.Verification" />
        <PackageReference Include="ShiroBot.SDK" Version="1.0.1" />
        <ProjectReference Include="$(MemeContractsProject)" />
    </ItemGroup>

    <Target Name="CopyPluginToHost"
            AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' and '$(UseLegacyDebugHost)' == 'true'">
        <MakeDir Directories="$(HostPluginDir)" />

        <ItemGroup>
            <PluginDebugOutput Include="$(TargetDir)**\*"
                               Exclude="$(TargetDir)ShiroBot.SDK.dll;$(TargetDir)ShiroBot.SDK.pdb;$(TargetDir)ShiroBot.Model.QQ.dll;$(TargetDir)ShiroBot.Model.QQ.pdb;$(TargetDir)Avalonia*.dll;$(TargetDir)Avalonia*.pdb;$(TargetDir)HarfBuzzSharp.dll;$(TargetDir)HarfBuzzSharp.pdb;$(TargetDir)MicroCom.Runtime.dll;$(TargetDir)MicroCom.Runtime.pdb;$(TargetDir)SkiaSharp.dll;$(TargetDir)SkiaSharp.pdb;$(TargetDir)runtimes\**\*" />
            <HostProvidedOutput Include="$(HostPluginDir)Avalonia*.dll;$(HostPluginDir)Avalonia*.pdb;$(HostPluginDir)HarfBuzzSharp.dll;$(HostPluginDir)HarfBuzzSharp.pdb;$(HostPluginDir)MicroCom.Runtime.dll;$(HostPluginDir)MicroCom.Runtime.pdb;$(HostPluginDir)SkiaSharp.dll;$(HostPluginDir)SkiaSharp.pdb" />
        </ItemGroup>

        <Delete Files="@(HostProvidedOutput)" />
        <RemoveDir Directories="$(HostPluginDir)runtimes" />
        <Copy SourceFiles="@(PluginDebugOutput)"
              DestinationFiles="@(PluginDebugOutput->'$(HostPluginDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>



  <!-- 契约 DLL 必须随插件发布；SDK 默认会把 SharedAssemblies 从输出中删除。 -->
  <Target Name="CopyMemeContractsToOutput"
          AfterTargets="RemoveShiroBotPluginDependencyFile"
          Condition="'$(ShiroBotPluginPackagingEnabled)' == 'true'">
    <ItemGroup>
      <_MemeContractReference Include="@(ReferencePath)"
                              Condition="'%(Filename)' == 'ShiroBot.Meme.Contracts'" />
    </ItemGroup>
    <Copy SourceFiles="@(_MemeContractReference)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMemeContractsToPublish"
          AfterTargets="RemovePublishedShiroBotPluginDependencyFile"
          Condition="'$(ShiroBotPluginPackagingEnabled)' == 'true'">
    <ItemGroup>
      <_MemeContractReference Include="@(ReferencePath)"
                              Condition="'%(Filename)' == 'ShiroBot.Meme.Contracts'" />
    </ItemGroup>
    <Copy SourceFiles="@(_MemeContractReference)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
